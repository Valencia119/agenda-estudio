# Copia este archivo como .env y llena los valores de tu proyecto de Supabase.
# Estos valores son públicos por diseño (la seguridad la dan las políticas RLS).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
# Clave pública VAPID para notificaciones push (la privada va SOLO en los secretos de Supabase)
VITE_VAPID_PUBLIC_KEY=tu-clave-publica-vapid
